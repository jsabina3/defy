# Copia este archivo a .env y rellena tus claves

# IA (selección de destinos y detalles de vuelo/hotel)
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-5.4-mini"

# Precios reales de vuelos + hoteles — Amadeus Self-Service
# Crea una app gratis en https://developers.amadeus.com (My Self-Service Workspace)
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
AMADEUS_ENV="test"          # "test" (gratis) o "production"

# Precios y referencias en vivo — RouteStack MCP (prioridad sobre Amadeus)
# Cuenta en https://www.routestack.ai  ·  endpoint MCP https://mcp.routestack.ai/mcp
# El servidor pide un partner-token firmado con el API secret (HMAC-SHA256).
ROUTESTACK_ACCOUNT_ID=""
ROUTESTACK_API_KEY=""
ROUTESTACK_API_SECRET=""
ROUTESTACK_MCP_URL="https://mcp.routestack.ai/mcp"

# Imágenes de alta calidad — Unsplash
# Clave gratuita en https://unsplash.com/developers (Access Key)
UNSPLASH_ACCESS_KEY=""

# Imágenes IA (gpt-image-1-mini) — caché en disco; en Railway monta un Volume en
# /app/public/assets/gen (Railway inyecta RAILWAY_VOLUME_MOUNT_PATH automáticamente).
# IMAGE_GEN_DIR=""          # override manual de la carpeta de caché
# IMAGE_QUALITY="low"       # low | medium | high
# IMAGE_SIZE="1536x1024"
# IMAGE_CONCURRENCY=4

# Opcional
PORT=3000
